<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1903 = transitive vulnerability advisory. Carved out so disclosure-window
         CVE alerts don't block local builds; CI/GHAS surfaces them separately. -->
    <WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
    <!-- CA1848 (use LoggerMessage delegates) is a hot-path micro-optimisation;
         VeloxClip's logging is all low-frequency lifecycle/per-capture events,
         so the source-generated-delegate boilerplate is not worth it. Silenced
         repo-wide. -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Company>VeloxClip</Company>
    <Authors>VeloxClip Contributors</Authors>
    <Product>VeloxClip</Product>
    <Copyright>Copyright (c) VeloxClip Contributors</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
